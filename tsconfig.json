{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"paths": {
			"@/*": ["./src/*"],
			// The package is named `crust`, and `examples/*` imports it by that name. A
			// checkout only resolved it when a stray `node_modules` happened to exist, so
			// the exports map is mirrored here and a clean clone typechecks.
			"crust": ["./src/index.ts"],
			"crust/plugin": ["./src/plugins/index.ts"],
			"crust/vite": ["./src/vite.ts"]
		}
	},
	"include": ["src", "scripts"]
}
