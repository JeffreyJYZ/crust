{
	"name": "crust",
	"version": "0.2.0",
	"description": "A Bun-native desktop app framework. No Rust. Just crust.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"crust": "src/cli/index.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugins/index.ts",
		"./extension": "./src/extensions/define.ts",
		"./extensions": "./src/extensions/load.ts",
		"./vite": "./src/vite.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"templates",
		"docs",
		"README.md",
		"DESIGN.md",
		"tsconfig.json"
	],
	"scripts": {
		"start": "bun run src/cli/index.ts",
		"typecheck": "bun check",
		"format": "bun fmt src scripts",
		"format:check": "bun fmt --check src scripts",
		"test": "bun test ./src ./examples scripts/release scripts/harness/focus-enforce.test.ts scripts/docs-reference.test.ts scripts/e2e-detail.test.ts scripts/e2e-parity-patterns.test.ts scripts/butter-sweep.test.ts",
		"test:no-skips": "bun test --reporter=junit --reporter-outfile=.junit-skips.xml ./src ./examples scripts/release scripts/docs-reference.test.ts scripts/e2e-detail.test.ts scripts/e2e-parity-patterns.test.ts scripts/butter-sweep.test.ts && bun scripts/check-skips.ts .junit-skips.xml",
		"e2e": "bun run scripts/e2e.ts",
		"e2e:notes": "bun run scripts/e2e-notes.ts",
		"e2e:window": "bun run scripts/e2e-window.ts",
		"e2e:fullscreen": "bun run scripts/e2e-fullscreen.ts",
		"e2e:dogear": "bun run scripts/e2e-dogear.ts",
		"e2e:capability": "bun run scripts/e2e-capability.ts",
		"check:lines": "bun run scripts/line-cap.ts",
		"skill": "bun run scripts/skill.ts",
		"skill:check": "bun run scripts/skill.ts --check",
		"site:build": "cd site && bun run build",
		"check:links": "bun run scripts/check-links.ts",
		"check:parity": "bun run scripts/check-parity.ts",
		"e2e:notify": "bun run scripts/e2e-notify.ts",
		"e2e:dev": "bun run scripts/e2e-dev.ts",
		"e2e:single": "bun run scripts/e2e-single.ts",
		"e2e:dev:react": "bun run scripts/e2e-dev-react.ts",
		"e2e:native": "bun run scripts/e2e-native.ts",
		"build:native": "bun run scripts/native-extensions.ts",
		"e2e:dev:binary": "bun run scripts/e2e-dev-binary.ts",
		"e2e:package": "bun run scripts/e2e-package.ts",
		"e2e:package:nsis": "bun run scripts/e2e-package-nsis.ts",
		"e2e:appimage": "bun run scripts/e2e-appimage.ts",
		"e2e:parity": "bun run scripts/e2e-parity.ts",
		"e2e:linux": "bun run scripts/e2e-linux.ts",
		"verify:package": "bun run scripts/verify-package.ts",
		"build:standalone": "bun run scripts/build-standalone.ts",
		"verify:first-run": "bun run scripts/first-run.ts",
		"demo": "bun run scripts/demo.ts",
		"release": "bun run scripts/release.ts",
		"verify:cellar": "bun run scripts/verify-cellar.ts",
		"verify": "bun check && bun test src/bridge src/plugins src/platform && bun fmt --check src"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"cac": "^7.1.0"
	}
}
