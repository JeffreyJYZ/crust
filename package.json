{
	"name": "crust",
	"version": "0.1.7",
	"description": "A Bun-native desktop app framework. No Rust. Just crust.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"crust": "src/cli/index.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugins/index.ts",
		"./vite": "./src/vite.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"templates",
		"docs",
		"README.md",
		"DESIGN.md",
		"tsconfig.json"
	],
	"scripts": {
		"start": "bun run src/cli/index.ts",
		"typecheck": "bun check",
		"format": "bun fmt src scripts",
		"format:check": "bun fmt --check src scripts",
		"test": "bun test src/bridge src/plugins src/platform src/cli",
		"e2e": "bun run scripts/e2e.ts",
		"e2e:notes": "bun run scripts/e2e-notes.ts",
		"e2e:window": "bun run scripts/e2e-window.ts",
		"e2e:dev": "bun run scripts/e2e-dev.ts",
		"e2e:single": "bun run scripts/e2e-single.ts",
		"e2e:dev:react": "bun run scripts/e2e-dev-react.ts",
		"e2e:dev:binary": "bun run scripts/e2e-dev-binary.ts",
		"e2e:package": "bun run scripts/e2e-package.ts",
		"verify:package": "bun run scripts/verify-package.ts",
		"build:standalone": "bun run scripts/build-standalone.ts",
		"verify:first-run": "bun run scripts/first-run.ts",
		"release": "bun run scripts/release.ts",
		"verify": "bun check && bun test src/bridge src/plugins src/platform && bun fmt --check src"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"vite": "^8.3.8"
	}
}
