{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "main.ts", "crust.config.ts", "vite.config.ts"]
}
