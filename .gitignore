# Build output
node_modules/
dist/
scripts/out/
*.dmg
*.app

# Third-party clones used for recon. The reports beside them are kept;
# the checkouts and their node_modules are not ours to publish.
research/*/repo/

# Throwaway probe output
research/*/probe/

# Runtime handshake between the bridge and a dev server
.crust/

# Native extensions are compiled, not committed: `bun run build:native` writes these.
examples/native/extensions/generated/

.DS_Store
*.log

# Docs site build output
site/.next/
